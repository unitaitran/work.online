{
  "name": "@dilam/server",
  "version": "0.0.0",
  "private": true,
  "description": "Server Đi làm Online: Fastify (REST) + ws (WebSocket)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts --dev",
    "build": "tsx scripts/build.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@dilam/shared": "*",
    "better-sqlite3": "12.4.1",
    "fastify": "5.12.7",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
