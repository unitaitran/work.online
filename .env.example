# Sao chép file này thành .env rồi sửa nếu cần. Không có .env thì dùng các giá trị mặc định dưới đây.

# Server (Fastify + WebSocket)
PORT=3000
HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Cổng dev server của Vite (client). Vite chuyển tiếp /api và /ws tới server ở PORT.
CLIENT_PORT=5173

# Dữ liệu SQLite (đường dẫn tính từ thư mục chạy server)
DB_PATH=data/dilam.sqlite
# Token hết hạn sau số ngày không dùng
TOKEN_TTL_DAYS=180
# Số người tối đa mỗi phòng văn phòng chung, và toàn server
ROOM_CAPACITY=40
SERVER_CAPACITY=400
# Khoá trang quản trị (ít nhất 24 ký tự). Để trống = tắt trang quản trị.
ADMIN_KEY=
# Đặt 1 khi chạy sau reverse proxy (Caddy/Nginx) để lấy IP thật
TRUST_PROXY=0
# Nguồn được gọi API từ trình duyệt (phân tách bằng dấu phẩy). Trống = cùng nguồn.
CORS_ORIGINS=
