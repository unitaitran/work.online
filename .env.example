# Sao chép thành .env rồi sửa. Không có .env thì dùng giá trị mặc định (chỉ hợp khi chạy thử trên máy).
# Server kiểm tra mọi biến lúc khởi động và dừng ngay nếu giá trị sai.

# ---------- Server (Fastify + WebSocket) ----------
PORT=3000
HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Cổng dev server của Vite (client). Vite chuyển tiếp /api, /ws, /admin tới server ở PORT.
CLIENT_PORT=5173

# ---------- Dữ liệu ----------
# File SQLite (đường dẫn tính từ thư mục chạy server; trong Docker: /data/dilam.sqlite)
DB_PATH=data/dilam.sqlite
# Sao lưu: thư mục, số bản giữ lại, lệnh tải lên nơi lưu ngoài máy chủ ({file} = bản sao)
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_UPLOAD_CMD=

# ---------- Tài khoản và phòng ----------
# Token hết hạn sau số ngày không dùng
TOKEN_TTL_DAYS=180
# Số người tối đa mỗi phòng văn phòng chung, toàn server, và số kết nối WebSocket mỗi IP
ROOM_CAPACITY=40
SERVER_CAPACITY=400
WS_PER_IP=8

# ---------- Bảo mật ----------
# Khoá trang quản trị /admin (ít nhất 24 ký tự, ngẫu nhiên). Để trống = tắt trang quản trị.
ADMIN_KEY=
# Đặt 1 khi chạy sau reverse proxy (Caddy/Nginx) để lấy IP thật từ X-Forwarded-For
TRUST_PROXY=0
# Nguồn khác được gọi API từ trình duyệt (phân tách bằng dấu phẩy). Trống = chỉ cùng nguồn.
CORS_ORIGINS=

# ---------- Triển khai ----------
# Tên miền cho Caddy (docker compose)
DOMAIN=localhost
# Mã bản build (ví dụ git sha); client so để báo "có phiên bản mới"
BUILD_ID=
# Thư mục bản build client để server phục vụ cùng nguồn (Docker tự đặt /app/client)
CLIENT_DIST=
# Công cụ dev (tua ngày, cộng XP). KHÔNG bật khi chạy thật (server từ chối khởi động).
DEV_TOOLS=0
# Tên đăng nhập được dùng "Công cụ dev" kể cả khi chạy thật (phân tách bằng dấu phẩy).
# Chỉ tài khoản đã đặt tên đăng nhập + mật khẩu, không áp dụng tài khoản khách. Bỏ trống = không ai.
DEV_USERS=taitran
